[Unit]
Description=Wangan Midnight Maximum Tune 3DX+ (HDMI)
After=local-fs.target systemd-udevd.service sound.target getty@tty1.service
Conflicts=getty@tty1.service

[Service]
User=wmmt
WorkingDirectory=/home/wmmt/game
Environment=SDL_VIDEODRIVER=kmsdrm WMMT_ANISO=4
# No --crt: the game draws at the screen's size, the 4:3 picture centred (pillarboxed on a 16:9 screen). Change --size to your
# screen's mode (1920x1080 here); SDL's KMS/DRM backend takes the first connected connector, so leave the composite settings
# out of cmdline.txt/config.txt (docs/PI.md) if you want HDMI to be picked.
ExecStart=/home/wmmt/game/super3dx data --save save --size 1920x1080 --fullscreen
StandardInput=null
StandardOutput=append:/home/wmmt/game/game.log
StandardError=append:/home/wmmt/game/game.log
Restart=always
RestartSec=2
# the display must be free before a restart
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
