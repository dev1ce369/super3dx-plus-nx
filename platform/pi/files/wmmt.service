[Unit]
Description=Wangan Midnight Maximum Tune 3DX+
After=local-fs.target systemd-udevd.service sound.target getty@tty1.service
Conflicts=getty@tty1.service

[Service]
User=wmmt
WorkingDirectory=/home/wmmt/game
Environment=SDL_VIDEODRIVER=kmsdrm WMMT_ANISO=4
ExecStart=/home/wmmt/game/super3dx data --save save --size 720x480 --fullscreen --crt
StandardInput=null
StandardOutput=append:/home/wmmt/game/game.log
StandardError=append:/home/wmmt/game/game.log
Restart=always
RestartSec=2
# the display must be free before a restart
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
